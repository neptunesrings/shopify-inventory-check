# Copy this file to .env and fill in your real credentials.
# IMPORTANT: .env is ignored by git (see .gitignore). Never commit your real .env file.
#
# Usage for developers:
#  1. Duplicate this file: `copy .env.template .env` (PowerShell) or `cp .env.template .env` (Unix)
#  2. Fill in the actual values for your environment (keep secrets in .env only).
#  3. Keep .env out of source control — it's already listed in .gitignore.
#
# Template (replace with your own values):
# Domain for your Shopify store (no surrounding quotes required)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com
# Public-facing site URL used for redirects and canonical URLs
SHOPIFY_SITE_URL=https://live.awge.com/products/group-non-signed-2-disc-vinyl-lp
# Private access token (keep this secret in your local .env)
SHOPIFY_ACCESS_TOKEN=__REPLACE_ME_WITH_SHOPIFY_ACCESS_TOKEN__
